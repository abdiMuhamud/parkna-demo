<?xml version="1.0" encoding="UTF-8"?>
<!--
  ParkNa logging. By default everything goes to Tomcat's logs folder:
    catalina.out        (console output, everything)
    parkna.log          ParkNa messages: startup, every action, database problems
    parkna-sms.log      SMS gateway traffic (Kannel accepted/rejected)
  Change the folder with -Dparkna.log.dir=... and the level with -Dparkna.log.level=DEBUG in bin/setenv.sh,
  or use your own file with -Dlog4j2.configurationFile=/path/to/log4j2.xml.
-->
<Configuration status="WARN">
  <Properties>
    <Property name="logDir">${sys:parkna.log.dir:-${sys:catalina.base:-.}/logs}</Property>
    <Property name="pattern">%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%t] %c{1} - %msg%n</Property>
  </Properties>
  <Appenders>
    <Console name="console" target="SYSTEM_OUT">
      <PatternLayout pattern="${pattern}"/>
    </Console>
    <RollingFile name="app" fileName="${logDir}/parkna.log" filePattern="${logDir}/parkna.%d{yyyy-MM-dd}.log.gz">
      <PatternLayout pattern="${pattern}"/>
      <Policies><TimeBasedTriggeringPolicy/></Policies>
      <DefaultRolloverStrategy>
        <Delete basePath="${logDir}" maxDepth="1"><IfFileName glob="parkna.*.log.gz"/><IfLastModified age="30d"/></Delete>
      </DefaultRolloverStrategy>
    </RollingFile>
    <RollingFile name="sms" fileName="${logDir}/parkna-sms.log" filePattern="${logDir}/parkna-sms.%d{yyyy-MM-dd}.log.gz">
      <PatternLayout pattern="${pattern}"/>
      <Policies><TimeBasedTriggeringPolicy/></Policies>
      <DefaultRolloverStrategy>
        <Delete basePath="${logDir}" maxDepth="1"><IfFileName glob="parkna-sms.*.log.gz"/><IfLastModified age="90d"/></Delete>
      </DefaultRolloverStrategy>
    </RollingFile>
  </Appenders>
  <Loggers>
    <Logger name="com.innovii.parkna.sms" level="${sys:parkna.log.level:-INFO}">
      <AppenderRef ref="sms"/>
    </Logger>
    <Logger name="com.innovii.parkna" level="${sys:parkna.log.level:-INFO}"/>
    <Logger name="com.zaxxer.hikari" level="WARN"/>
    <Root level="INFO">
      <AppenderRef ref="console"/>
      <AppenderRef ref="app"/>
    </Root>
  </Loggers>
</Configuration>
